// Login Attempts Log (for security tracking)
model sps_login_attempts {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Attempt Details
  email      String  @db.VarChar(255)
  user_id    String? @db.Uuid
  ip_address String  @db.VarChar(50)
  user_agent String?

  // Result
  success        Boolean
  failure_reason String? @db.VarChar(100) // INVALID_PASSWORD, USER_NOT_FOUND, ACCOUNT_LOCKED, etc.

  // 2FA if applicable
  two_factor_required Boolean? @default(false)
  two_factor_method   String?  @db.VarChar(20)
  two_factor_success  Boolean?

  created_at DateTime? @default(now()) @db.Timestamptz(6)

  sps_users sps_users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([email], map: "idx_login_attempts_email")
  @@index([ip_address], map: "idx_login_attempts_ip")
  @@index([created_at], map: "idx_login_attempts_created")
}

model sps_task_evidence {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  task_id     String     @db.Uuid
  type        String     @db.VarChar(20)
  url         String
  description String?
  uploaded_by String?    @db.Uuid
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  sps_tasks   sps_tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users   sps_users? @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sps_tasks {
  id                                         String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id                            String              @db.Uuid
  department_id                              String?             @db.Uuid
  title                                      String              @db.VarChar(200)
  description                                String?
  priority                                   String?             @default("MEDIUM") @db.VarChar(20)
  status                                     String?             @default("PENDING") @db.VarChar(20)
  assigned_to                                String?             @db.Uuid
  created_by                                 String?             @db.Uuid
  due_date                                   DateTime?           @db.Timestamptz(6)
  completed_at                               DateTime?           @db.Timestamptz(6)
  created_at                                 DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime?           @default(now()) @db.Timestamptz(6)
  sps_task_evidence                          sps_task_evidence[]
  sps_users_sps_tasks_assigned_toTosps_users sps_users?          @relation("sps_tasks_assigned_toTosps_users", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_users_sps_tasks_created_byTosps_users  sps_users?          @relation("sps_tasks_created_byTosps_users", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_departments                            sps_departments?    @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  sps_organizations                          sps_organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_tasks_org")
}

model sps_telemetry {
  id              Int          @id @default(autoincrement())
  device_id       Int?
  device_code     String       @db.VarChar(50)
  organization_id String       @db.Uuid
  event_id        String?      @db.Uuid
  service_id      String?      @db.Uuid
  data            Json
  recorded_at     DateTime?    @default(now()) @db.Timestamptz(6)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  sps_devices     sps_devices? @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([device_id], map: "idx_telemetry_device")
  @@index([organization_id], map: "idx_telemetry_org")
  @@index([recorded_at(sort: Desc)], map: "idx_telemetry_recorded")
}

model sps_users {
  id                                         String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id                            String?                   @db.Uuid
  code                                       String?                   @unique @db.VarChar(50)
  email                                      String                    @unique @db.VarChar(255)
  password_hash                              String
  full_name                                  String?                   @db.VarChar(100)
  timezone                                   String?                   @default("UTC") @db.VarChar(50)
  is_active                                  Boolean?                  @default(true)
  is_super_admin                             Boolean?                  @default(false)
  failed_login_attempts                      Int?                      @default(0)
  account_locked_until                       DateTime?                 @db.Timestamptz(6)
  last_login                                 DateTime?                 @db.Timestamptz(6)
  // 2FA Fields
  two_factor_enabled                         Boolean?                  @default(false)
  two_factor_secret                          String?                   @db.VarChar(255) // Encrypted TOTP secret
  two_factor_backup_codes                    String?                   @db.Text // Encrypted backup codes (JSON array)
  two_factor_verified_at                     DateTime?                 @db.Timestamptz(6)
  // Email verification
  email_verified                             Boolean?                  @default(false)
  email_verified_at                          DateTime?                 @db.Timestamptz(6)
  // Session management
  force_password_change                      Boolean?                  @default(false)
  password_changed_at                        DateTime?                 @db.Timestamptz(6)
  created_at                                 DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime?                 @default(now()) @db.Timestamptz(6)
  sps_alerts                                 sps_alerts[]
  sps_audit_logs                             sps_audit_logs[]
  sps_dashboard_templates                    sps_dashboard_templates[]
  sps_department_services                    sps_department_services[]
  sps_departments                            sps_departments[]
  sps_role_assignments                       sps_role_assignments[]
  sps_task_evidence                          sps_task_evidence[]
  sps_tasks_sps_tasks_assigned_toTosps_users sps_tasks[]               @relation("sps_tasks_assigned_toTosps_users")
  sps_tasks_sps_tasks_created_byTosps_users  sps_tasks[]               @relation("sps_tasks_created_byTosps_users")
  sps_organizations                          sps_organizations?        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // New relations for system configuration
  sps_password_history sps_password_history[]
  sps_user_two_factor  sps_user_two_factor?
  sps_api_keys         sps_api_keys[]
  sps_user_sessions    sps_user_sessions[]
  sps_login_attempts   sps_login_attempts[]
  sps_refresh_tokens   sps_refresh_tokens[]
  sps_otp_codes        sps_otp_codes[]
  // sps_user_sessions    sps_user_sessions[]

  @@index([email], map: "idx_users_email")
  @@index([organization_id], map: "idx_users_org")
}

// Refresh Tokens - for secure token storage and revocation
model sps_refresh_tokens {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String    @db.Uuid
  token_hash     String    @db.VarChar(255) // Hashed refresh token for security
  device_info    String?   @db.VarChar(500) // Browser/device identifier
  ip_address     String?   @db.VarChar(45) // IPv4 or IPv6
  expires_at     DateTime  @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_reason String?   @db.VarChar(100) // logout, password_change, admin_action, etc.
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  sps_users sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([token_hash], map: "idx_refresh_tokens_hash")
  @@index([expires_at], map: "idx_refresh_tokens_expires")
}

// OTP Codes - for email verification and password reset
model sps_otp_codes {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  code_hash    String    @db.VarChar(255) // Hashed OTP code
  purpose      String    @db.VarChar(50) // email_verification, password_reset, login_2fa
  expires_at   DateTime  @db.Timestamptz(6)
  used_at      DateTime? @db.Timestamptz(6)
  attempts     Int       @default(0) // Track verification attempts
  max_attempts Int       @default(3) // Prevent brute force
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  sps_users sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_otp_codes_user")
  @@index([expires_at], map: "idx_otp_codes_expires")
}

// User Sessions - for session management and timeout handling
// User Sessions - for session management and timeout handling
model sps_user_sessions {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String   @db.Uuid
  refresh_token_id String?  @db.Uuid
  device_info      String?  @db.VarChar(500)
  ip_address       String?  @db.VarChar(45)
  user_agent       String?  @db.VarChar(500)
  last_activity    DateTime @default(now()) @db.Timestamptz(6)
  expires_at       DateTime @db.Timestamptz(6)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  sps_users sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_sessions_user")
  @@index([last_activity], map: "idx_user_sessions_activity")
  @@index([is_active], map: "idx_user_sessions_active")
}
