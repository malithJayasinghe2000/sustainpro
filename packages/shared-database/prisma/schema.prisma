generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model sps_alert_rules {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String            @db.Uuid
  name              String            @db.VarChar(100)
  description       String?
  condition         Json
  severity          String?           @default("WARNING") @db.VarChar(20)
  is_active         Boolean?          @default(true)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  sps_organizations sps_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_alerts        sps_alerts[]
}

model sps_alerts {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rule_id           String?           @db.Uuid
  organization_id   String            @db.Uuid
  device_id         Int?
  message           String
  severity          String?           @default("WARNING") @db.VarChar(20)
  status            String?           @default("ACTIVE") @db.VarChar(20)
  acknowledged_by   String?           @db.Uuid
  acknowledged_at   DateTime?         @db.Timestamptz(6)
  resolved_at       DateTime?         @db.Timestamptz(6)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?        @relation(fields: [acknowledged_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_devices       sps_devices?      @relation(fields: [device_id], references: [id], onUpdate: NoAction)
  sps_organizations sps_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_alert_rules   sps_alert_rules?  @relation(fields: [rule_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_alerts_org")
}

model sps_audit_logs {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String?            @db.Uuid
  actor_user_id     String?            @db.Uuid
  action            String             @db.VarChar(100)
  target_resource   String?            @db.VarChar(50)
  target_id         String?            @db.VarChar(100)
  changes           Json?
  ip_address        String?            @db.VarChar(50)
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?         @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  sps_organizations sps_organizations? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@index([organization_id, created_at(sort: Desc)], map: "idx_audit_org_date")
}

model sps_dashboard_templates {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String?            @db.Uuid
  name              String             @db.VarChar(100)
  description       String?
  layout            Json               @default("{\"widgets\": []}")
  is_default        Boolean?           @default(false)
  created_by        String?            @db.Uuid
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_organizations sps_organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sps_department_services {
  id                     String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  department_id          String                 @db.Uuid
  service_template_id    String                 @db.Uuid
  name                   String?                @db.VarChar(100)
  config                 Json?                  @default("{}")
  status                 String?                @default("ACTIVE") @db.VarChar(50)
  assigned_supervisor_id String?                @db.Uuid
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  sps_users              sps_users?             @relation(fields: [assigned_supervisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_departments        sps_departments        @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates  sps_service_templates  @relation(fields: [service_template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_devices            sps_devices[]
  sps_role_assignments   sps_role_assignments[]

  @@index([department_id], map: "idx_dept_services_dept")
}

model sps_department_templates {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String?            @db.Uuid
  name               String             @db.VarChar(100)
  description        String?
  icon               String?            @db.VarChar(50)
  color              String?            @db.VarChar(20)
  suggested_services Json?              @default("[]")
  required_roles     Json?              @default("[]")
  is_active          Boolean?           @default(true)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  sps_organizations  sps_organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_dept_templates_org")
}

model sps_departments {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id                String                    @db.Uuid
  name                    String                    @db.VarChar(100)
  description             String?
  icon                    String?                   @db.VarChar(50)
  color                   String?                   @db.VarChar(20)
  head_user_id            String?                   @db.Uuid
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  sps_department_services sps_department_services[]
  sps_events              sps_events                @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users               sps_users?                @relation(fields: [head_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_role_assignments    sps_role_assignments[]
  sps_tasks               sps_tasks[]

  @@index([event_id], map: "idx_depts_event")
}

model sps_device_models {
  id                        String                      @id @db.VarChar(50)
  name                      String                      @db.VarChar(100)
  description               String?
  parameters                Json?                       @default("[]")
  created_by                String?                     @db.VarChar(50)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_service_device_models sps_service_device_models[]
}

model sps_devices {
  id                      Int                      @id @default(autoincrement())
  organization_id         String                   @db.Uuid
  service_id              String?                  @db.Uuid
  event_id                String?                  @db.Uuid
  device_code             String                   @unique @db.VarChar(50)
  api_key                 String?                  @unique @db.VarChar(100)
  name                    String?                  @db.VarChar(100)
  type                    String?                  @db.VarChar(50)
  status                  String?                  @default("OFFLINE") @db.VarChar(50)
  last_seen               DateTime?                @db.Timestamptz(6)
  metadata                Json?                    @default("{}")
  created_at              DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                @default(now()) @db.Timestamptz(6)
  sps_alerts              sps_alerts[]
  sps_events              sps_events?              @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  sps_organizations       sps_organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_department_services sps_department_services? @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  sps_telemetry           sps_telemetry[]

  @@index([device_code], map: "idx_devices_code")
  @@index([organization_id], map: "idx_devices_org")
  @@index([service_id], map: "idx_devices_service")
}

model sps_events {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id      String                 @db.Uuid
  name                 String                 @db.VarChar(100)
  code                 String?                @unique @db.VarChar(50)
  location             String?                @db.VarChar(255)
  start_date           DateTime?              @db.Timestamptz(6)
  end_date             DateTime?              @db.Timestamptz(6)
  status               String?                @default("PLANNING") @db.VarChar(50)
  description          String?
  event_type           String?                @db.VarChar(50)
  image_url            String?
  coordinates          Json?                  @default("{}")
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  sps_departments      sps_departments[]
  sps_devices          sps_devices[]
  sps_organizations    sps_organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_role_assignments sps_role_assignments[]

  @@index([organization_id], map: "idx_events_org")
  @@index([status], map: "idx_events_status")
}

model sps_organizations {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                      String                      @unique @db.VarChar(100)
  slug                      String                      @unique @db.VarChar(50)
  code                      String?                     @unique @db.VarChar(50)
  type                      String?                     @default("CLIENT") @db.VarChar(50)
  description               String?
  industry                  String?                     @db.VarChar(100)
  website                   String?                     @db.VarChar(255)
  logo_url                  String?
  timezone                  String?                     @default("UTC") @db.VarChar(100)
  address                   String?
  city                      String?                     @db.VarChar(100)
  country                   String?                     @db.VarChar(100)
  phone                     String?                     @db.VarChar(50)
  vat_id                    String?                     @db.VarChar(50)
  billing_email             String?                     @db.VarChar(255)
  contact_email             String?                     @db.VarChar(255)
  plan_tier                 String?                     @default("BASIC") @db.VarChar(50)
  max_users                 Int?                        @default(5)
  max_devices               Int?                        @default(10)
  subscription_status       String?                     @default("ACTIVE") @db.VarChar(50)
  theme_config              Json?                       @default("{}")
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_alert_rules           sps_alert_rules[]
  sps_alerts                sps_alerts[]
  sps_audit_logs            sps_audit_logs[]
  sps_dashboard_templates   sps_dashboard_templates[]
  sps_department_templates  sps_department_templates[]
  sps_devices               sps_devices[]
  sps_events                sps_events[]
  sps_role_assignments      sps_role_assignments[]
  sps_service_subscriptions sps_service_subscriptions[]
  sps_tasks                 sps_tasks[]
  sps_users                 sps_users[]
  sps_api_keys              sps_api_keys[]
}

model sps_permissions {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String                 @unique @db.VarChar(100)
  code                 String                 @unique @db.VarChar(50)
  description          String?
  category             String?                @db.VarChar(50)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  sps_role_permissions sps_role_permissions[]
}

// =============================================
// ROLES TABLE - Centralized Role Definitions
// =============================================
// This table defines all available roles in the system.
// The 'code' field is used as a reference key in:
//   - sps_role_assignments.role (which user has which role)
//   - sps_role_permissions.role (which role has which permissions)
// This allows dynamic role management while preserving existing functionality.

model sps_roles {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String    @unique @db.VarChar(50) // e.g., "ORG_ADMIN", "EVENT_MANAGER"
  name        String    @db.VarChar(100) // e.g., "Organization Admin"
  description String? // Role description
  level       Int       @default(0) // Hierarchy level (0=highest, higher=lower rank)
  icon        String?   @db.VarChar(50) // Icon name for UI (e.g., "Building2", "Calendar")
  color       String?   @db.VarChar(20) // Color for UI (e.g., "#3B82F6")
  is_system   Boolean   @default(false) // System roles cannot be deleted
  is_active   Boolean   @default(true) // Can be disabled without deletion
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([code], map: "idx_roles_code")
  @@index([level], map: "idx_roles_level")
}

model sps_role_assignments {
  id                      String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                 String                   @db.Uuid
  role                    String                   @db.VarChar(50)
  org_id                  String?                  @db.Uuid
  event_id                String?                  @db.Uuid
  dept_id                 String?                  @db.Uuid
  service_id              String?                  @db.Uuid
  created_at              DateTime?                @default(now()) @db.Timestamptz(6)
  sps_departments         sps_departments?         @relation(fields: [dept_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_events              sps_events?              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_organizations       sps_organizations?       @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_department_services sps_department_services? @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users               sps_users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_role_assign_user")
}

model sps_role_permissions {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role            String          @db.VarChar(50)
  permission_id   String          @db.Uuid
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  sps_permissions sps_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role, permission_id])
}

model sps_service_device_models {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  service_template_id   String                @db.Uuid
  device_model_id       String                @db.VarChar(50)
  is_required           Boolean?              @default(false)
  max_devices           Int?
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  sps_device_models     sps_device_models     @relation(fields: [device_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates sps_service_templates @relation(fields: [service_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([service_template_id, device_model_id])
}

model sps_service_subscriptions {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id       String                @db.Uuid
  service_template_id   String                @db.Uuid
  status                String?               @default("ACTIVE") @db.VarChar(50)
  subscribed_at         DateTime?             @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?             @db.Timestamptz(6)
  config_overrides      Json?                 @default("{}")
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  sps_organizations     sps_organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates sps_service_templates @relation(fields: [service_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, service_template_id])
}

model sps_service_templates {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                      String                      @unique @db.VarChar(100)
  code                      String                      @unique @db.VarChar(50)
  category                  String?                     @default("MONITORING") @db.VarChar(50)
  description               String?
  config_schema             Json?                       @default("{}")
  default_config            Json?                       @default("{}")
  main_dashboard_layout     Json?                       @default("{\"widgets\": []}")
  public_dashboard_layout   Json?                       @default("{\"widgets\": []}")
  features                  Json?                       @default("[]")
  required_permissions      Json?                       @default("[]")
  base_price                Decimal?                    @default(0) @db.Decimal(10, 2)
  price_per_device          Decimal?                    @default(0) @db.Decimal(10, 2)
  is_public                 Boolean?                    @default(true)
  is_active                 Boolean?                    @default(true)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_department_services   sps_department_services[]
  sps_service_device_models sps_service_device_models[]
  sps_service_subscriptions sps_service_subscriptions[]
}

// =============================================
// SYSTEM CONFIGURATION TABLES
// =============================================

// Global System Settings - Core branding and system configuration
model sps_system_settings {
  id String @id @default("sps_main_config") @db.VarChar(100)

  // System Branding
  system_name     String? @default("SustainPro") @db.VarChar(100)
  site_title      String? @default("SustainPro") @db.VarChar(100)
  site_tagline    String? @db.VarChar(255)
  site_logo       String? // URL to logo
  site_favicon    String? // URL to favicon
  primary_color   String? @default("#3B82F6") @db.VarChar(20)
  secondary_color String? @default("#10B981") @db.VarChar(20)

  // Timezone & Locale
  default_timezone  String? @default("Asia/Dubai") @db.VarChar(100)
  default_language  String? @default("en") @db.VarChar(10)
  date_format       String? @default("DD/MM/YYYY") @db.VarChar(50)
  time_format       String? @default("HH:mm:ss") @db.VarChar(50)
  datetime_format   String? @default("DD/MM/YYYY HH:mm:ss") @db.VarChar(100)
  first_day_of_week Int?    @default(0) // 0=Sunday, 1=Monday

  // System Status
  maintenance_mode     Boolean? @default(false)
  maintenance_message  String?
  global_alert_message String?
  global_alert_type    String?  @default("INFO") @db.VarChar(20) // INFO, WARNING, ERROR

  // Support Contact
  support_email String? @db.VarChar(255)
  support_phone String? @db.VarChar(50)
  support_url   String? @db.VarChar(255)

  // SEO & Meta
  meta_description String?
  meta_keywords    String?

  // Security Settings
  account_lock_duration_minutes Int?     @default(30)
  token_expire_minutes          Int?     @default(60)
  refresh_token_expire_days     Int?     @default(7)
  max_login_attempts            Int?     @default(5)
  session_timeout_enabled       Boolean? @default(true)
  session_timeout_minutes       Int?     @default(30)

  // 2FA Policy Settings
  two_factor_required Boolean? @default(false) // Force all users to enable 2FA
  two_factor_method   String?  @default("email") @db.VarChar(20) // email, totp, or both
  otp_expiry_minutes  Int?     @default(10)
  otp_length          Int?     @default(6)

  // Rate Limiting
  login_rate_limit_attempts    Int? @default(5)
  login_rate_limit_window_mins Int? @default(15)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// Password Policies - Authentication password requirements
model sps_password_policies {
  id String @id @default("sps_password_policy") @db.VarChar(100)

  // Minimum Requirements
  min_length            Int?     @default(8)
  max_length            Int?     @default(128)
  require_uppercase     Boolean? @default(true)
  require_lowercase     Boolean? @default(true)
  require_numbers       Boolean? @default(true)
  require_special_chars Boolean? @default(true)
  special_chars_allowed String?  @default("!@#$%^&*()_+-=[]{}|;:,.<>?") @db.VarChar(100)

  // Password Expiration
  password_expires     Boolean? @default(false)
  password_expiry_days Int?     @default(90)
  expiry_warning_days  Int?     @default(14) // Days before expiry to warn user

  // Password Reuse Prevention
  prevent_reuse          Boolean? @default(true)
  reuse_prevention_count Int?     @default(5) // Number of previous passwords to check

  // Password Change Requirements
  require_change_on_first_login Boolean? @default(true)
  min_password_age_hours        Int?     @default(0) // Minimum hours before password can be changed again

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// Session Management Policies
model sps_session_policies {
  id String @id @default("sps_session_policy") @db.VarChar(100)

  // Session Timeout
  session_timeout_enabled Boolean? @default(true)
  session_timeout_minutes Int?     @default(60)
  idle_timeout_enabled    Boolean? @default(true)
  idle_timeout_minutes    Int?     @default(30)

  // Session Limits
  max_concurrent_sessions Int?     @default(5)
  enforce_single_session  Boolean? @default(false) // Force logout from other devices

  // Token Settings
  access_token_expire_minutes Int? @default(60)
  refresh_token_expire_days   Int? @default(7)
  remember_me_expire_days     Int? @default(30)

  // Session Security
  bind_session_to_ip          Boolean? @default(false)
  bind_session_to_user_agent  Boolean? @default(false)
  regenerate_session_on_login Boolean? @default(true)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// Login Attempt Policies
model sps_login_policies {
  id String @id @default("sps_login_policy") @db.VarChar(100)

  // Failed Login Attempts
  max_login_attempts             Int?     @default(5)
  lockout_duration_minutes       Int?     @default(30)
  progressive_lockout            Boolean? @default(true) // Increase lockout duration after repeated failures
  progressive_lockout_multiplier Float?   @default(2.0)
  max_lockout_duration_minutes   Int?     @default(1440) // Maximum 24 hours

  // Captcha Settings
  enable_captcha         Boolean? @default(false)
  captcha_after_attempts Int?     @default(3) // Show captcha after N failed attempts
  captcha_provider       String?  @default("RECAPTCHA") @db.VarChar(50) // RECAPTCHA, HCAPTCHA
  captcha_site_key       String?
  captcha_secret_key     String?

  // IP-based Blocking
  enable_ip_blocking        Boolean? @default(true)
  ip_block_threshold        Int?     @default(10) // Block IP after N failed attempts
  ip_block_duration_minutes Int?     @default(60)

  // Notification on Suspicious Activity
  notify_on_lockout          Boolean? @default(true)
  notify_on_new_device_login Boolean? @default(true)
  notify_on_password_change  Boolean? @default(true)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// Two-Factor Authentication Configuration
model sps_two_factor_config {
  id String @id @default("sps_2fa_config") @db.VarChar(100)

  // 2FA Enforcement
  enabled            Boolean? @default(true)
  enforce_globally   Boolean? @default(false)
  enforce_for_admins Boolean? @default(true)
  grace_period_days  Int?     @default(7) // Days before 2FA is required after enable

  // Available Methods
  email_method_enabled Boolean? @default(true)
  sms_method_enabled   Boolean? @default(false)
  totp_method_enabled  Boolean? @default(true) // Authenticator apps

  // Email OTP Settings
  email_otp_length         Int? @default(6)
  email_otp_expiry_minutes Int? @default(10)
  email_otp_max_attempts   Int? @default(3)

  // SMS OTP Settings  
  sms_otp_length         Int?    @default(6)
  sms_otp_expiry_minutes Int?    @default(5)
  sms_otp_max_attempts   Int?    @default(3)
  sms_provider           String? @db.VarChar(50) // TWILIO, NEXMO, etc.
  sms_api_key            String?
  sms_api_secret         String?
  sms_sender_id          String? @db.VarChar(20)

  // TOTP Settings
  totp_issuer    String? @default("SustainPro") @db.VarChar(100)
  totp_algorithm String? @default("SHA1") @db.VarChar(10)
  totp_digits    Int?    @default(6)
  totp_period    Int?    @default(30) // Seconds

  // Recovery Codes
  recovery_codes_enabled Boolean? @default(true)
  recovery_codes_count   Int?     @default(10)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// API Security Configuration
model sps_api_security_config {
  id String @id @default("sps_api_security") @db.VarChar(100)

  // Rate Limiting
  rate_limit_enabled        Boolean? @default(true)
  rate_limit_requests       Int?     @default(100) // Requests per window
  rate_limit_window_minutes Int?     @default(1)
  rate_limit_by             String?  @default("IP") @db.VarChar(20) // IP, USER, API_KEY

  // API Key Settings
  api_key_enabled              Boolean? @default(true)
  api_key_expiry_days          Int?     @default(365)
  api_key_max_per_user         Int?     @default(5)
  api_key_require_ip_whitelist Boolean? @default(false)

  // CORS Settings
  cors_enabled           Boolean? @default(true)
  cors_allowed_origins   String?  @default("*")
  cors_allowed_methods   String?  @default("GET,POST,PUT,PATCH,DELETE,OPTIONS")
  cors_allowed_headers   String?  @default("Content-Type,Authorization,X-API-Key")
  cors_max_age_seconds   Int?     @default(86400)
  cors_allow_credentials Boolean? @default(true)

  // API Versioning
  api_versioning_enabled      Boolean? @default(true)
  current_api_version         String?  @default("v1") @db.VarChar(20)
  supported_versions          String?  @default("v1") // Comma-separated list
  deprecation_warning_enabled Boolean? @default(true)

  // Request Limits
  max_request_body_size_mb Int? @default(10)
  request_timeout_seconds  Int? @default(30)

  // Security Headers
  enable_security_headers Boolean? @default(true)
  hsts_enabled            Boolean? @default(true)
  hsts_max_age_seconds    Int?     @default(31536000)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// SMTP Email Configuration
model sps_smtp_settings {
  id String @id @default("sps_smtp_config") @db.VarChar(100)

  // SMTP Server Settings
  smtp_enabled         Boolean? @default(true)
  smtp_host            String?  @db.VarChar(255)
  smtp_port            Int?     @default(587)
  smtp_username        String?  @db.VarChar(255)
  smtp_password        String? // Encrypted
  smtp_encryption      String?  @default("TLS") @db.VarChar(10) // NONE, SSL, TLS
  smtp_timeout_seconds Int?     @default(30)

  // Sender Settings
  from_email     String? @db.VarChar(255)
  from_name      String? @default("SustainPro") @db.VarChar(100)
  reply_to_email String? @db.VarChar(255)

  // Email Limits
  max_emails_per_hour      Int? @default(100)
  max_emails_per_day       Int? @default(1000)
  max_recipients_per_email Int? @default(50)

  // Testing
  test_mode            Boolean? @default(false)
  test_email_recipient String?  @db.VarChar(255)

  // Connection Health
  last_connection_test   DateTime? @db.Timestamptz(6)
  last_connection_status String?   @db.VarChar(50) // SUCCESS, FAILED
  last_connection_error  String?

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// Email Templates
model sps_email_templates {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Template Identification
  code        String  @unique @db.VarChar(50) // WELCOME, PASSWORD_RESET, 2FA_OTP, etc.
  name        String  @db.VarChar(100)
  description String?
  category    String? @default("SYSTEM") @db.VarChar(50) // SYSTEM, ALERT, TASK, REPORT

  // Template Content
  subject   String  @db.VarChar(255)
  body_html String // HTML content
  body_text String? // Plain text fallback

  // Template Variables (JSON array of available variables)
  available_variables Json? @default("[]")

  // Settings
  is_active          Boolean? @default(true)
  is_system_template Boolean? @default(false) // Cannot be deleted if true
  language           String?  @default("en") @db.VarChar(10)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([code], map: "idx_email_templates_code")
  @@index([category], map: "idx_email_templates_category")
}

// Notification Settings
model sps_notification_settings {
  id String @id @default("sps_notification_config") @db.VarChar(100)

  // Email Notification Frequency
  email_notifications_enabled Boolean? @default(true)
  email_frequency             String?  @default("IMMEDIATE") @db.VarChar(20) // IMMEDIATE, HOURLY, DAILY
  email_batch_size            Int?     @default(10)
  email_digest_time           String?  @default("09:00") @db.VarChar(10) // For daily digest

  // Quiet Hours
  quiet_hours_enabled         Boolean? @default(false)
  quiet_hours_start           String?  @default("22:00") @db.VarChar(10)
  quiet_hours_end             String?  @default("07:00") @db.VarChar(10)
  quiet_hours_timezone        String?  @default("UTC") @db.VarChar(100)
  quiet_hours_override_urgent Boolean? @default(true) // Urgent notifications bypass quiet hours

  // In-App Notifications
  in_app_notifications_enabled Boolean? @default(true)
  in_app_auto_dismiss_seconds  Int?     @default(5)
  in_app_max_visible           Int?     @default(5)

  // Push Notifications
  push_notifications_enabled Boolean? @default(false)
  push_provider              String?  @db.VarChar(50) // FCM, APNS, etc.
  push_api_key               String?

  // Notification Retention
  retention_days Int? @default(30)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// User Password History (for reuse prevention)
model sps_password_history {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String    @db.Uuid
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  sps_users sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_password_history_user")
}

// User 2FA Settings (per-user 2FA configuration)
model sps_user_two_factor {
  id      String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id String @unique @db.Uuid

  // 2FA Status
  is_enabled Boolean?  @default(false)
  enabled_at DateTime? @db.Timestamptz(6)

  // Active Methods
  email_enabled Boolean? @default(false)
  sms_enabled   Boolean? @default(false)
  totp_enabled  Boolean? @default(false)

  // TOTP Secret (encrypted)
  totp_secret      String?
  totp_verified_at DateTime? @db.Timestamptz(6)

  // Backup Phone for SMS
  backup_phone   String?  @db.VarChar(20)
  phone_verified Boolean? @default(false)

  // Recovery Codes (encrypted JSON array)
  recovery_codes              String?
  recovery_codes_generated_at DateTime? @db.Timestamptz(6)
  recovery_codes_used         Int?      @default(0)

  // Last Used
  last_used_method String?   @db.VarChar(20)
  last_used_at     DateTime? @db.Timestamptz(6)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  sps_users sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// API Keys
model sps_api_keys {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String  @db.Uuid
  organization_id String? @db.Uuid

  // Key Details
  name       String @db.VarChar(100)
  key_hash   String @unique // Hashed API key
  key_prefix String @db.VarChar(10) // First few chars for identification

  // Permissions & Scope
  scopes       Json? @default("[]") // Array of allowed scopes/permissions
  ip_whitelist Json? @default("[]") // Array of allowed IPs

  // Status
  is_active  Boolean?  @default(true)
  expires_at DateTime? @db.Timestamptz(6)

  // Usage Tracking
  last_used_at DateTime? @db.Timestamptz(6)
  last_used_ip String?   @db.VarChar(50)
  usage_count  Int?      @default(0)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  sps_users         sps_users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_organizations sps_organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_api_keys_user")
  @@index([organization_id], map: "idx_api_keys_org")
}

