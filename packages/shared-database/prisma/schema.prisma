generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model sps_alert_rules {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String            @db.Uuid
  name              String            @db.VarChar(100)
  description       String?
  condition         Json
  severity          String?           @default("WARNING") @db.VarChar(20)
  is_active         Boolean?          @default(true)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  sps_organizations sps_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_alerts        sps_alerts[]
}

model sps_alerts {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rule_id           String?           @db.Uuid
  organization_id   String            @db.Uuid
  device_id         Int?
  message           String
  severity          String?           @default("WARNING") @db.VarChar(20)
  status            String?           @default("ACTIVE") @db.VarChar(20)
  acknowledged_by   String?           @db.Uuid
  acknowledged_at   DateTime?         @db.Timestamptz(6)
  resolved_at       DateTime?         @db.Timestamptz(6)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?        @relation(fields: [acknowledged_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_devices       sps_devices?      @relation(fields: [device_id], references: [id], onUpdate: NoAction)
  sps_organizations sps_organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_alert_rules   sps_alert_rules?  @relation(fields: [rule_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_alerts_org")
}

model sps_audit_logs {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String?            @db.Uuid
  actor_user_id     String?            @db.Uuid
  action            String             @db.VarChar(100)
  target_resource   String?            @db.VarChar(50)
  target_id         String?            @db.VarChar(100)
  changes           Json?
  ip_address        String?            @db.VarChar(50)
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?         @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  sps_organizations sps_organizations? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@index([organization_id, created_at(sort: Desc)], map: "idx_audit_org_date")
}

model sps_dashboard_templates {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String?            @db.Uuid
  name              String             @db.VarChar(100)
  description       String?
  layout            Json               @default("{\"widgets\": []}")
  is_default        Boolean?           @default(false)
  created_by        String?            @db.Uuid
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  sps_users         sps_users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_organizations sps_organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sps_department_services {
  id                     String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  department_id          String                 @db.Uuid
  service_template_id    String                 @db.Uuid
  name                   String?                @db.VarChar(100)
  config                 Json?                  @default("{}")
  status                 String?                @default("ACTIVE") @db.VarChar(50)
  assigned_supervisor_id String?                @db.Uuid
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  sps_users              sps_users?             @relation(fields: [assigned_supervisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_departments        sps_departments        @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates  sps_service_templates  @relation(fields: [service_template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_devices            sps_devices[]
  sps_role_assignments   sps_role_assignments[]

  @@index([department_id], map: "idx_dept_services_dept")
}

model sps_department_templates {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String?            @db.Uuid
  name               String             @db.VarChar(100)
  description        String?
  icon               String?            @db.VarChar(50)
  color              String?            @db.VarChar(20)
  suggested_services Json?              @default("[]")
  required_roles     Json?              @default("[]")
  is_active          Boolean?           @default(true)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @default(now()) @db.Timestamptz(6)
  sps_organizations  sps_organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_dept_templates_org")
}

model sps_departments {
  id                      String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_id                String                    @db.Uuid
  name                    String                    @db.VarChar(100)
  description             String?
  icon                    String?                   @db.VarChar(50)
  color                   String?                   @db.VarChar(20)
  head_user_id            String?                   @db.Uuid
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  sps_department_services sps_department_services[]
  sps_events              sps_events                @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users               sps_users?                @relation(fields: [head_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_role_assignments    sps_role_assignments[]
  sps_tasks               sps_tasks[]

  @@index([event_id], map: "idx_depts_event")
}

model sps_device_models {
  id                        String                      @id @db.VarChar(50)
  name                      String                      @db.VarChar(100)
  description               String?
  parameters                Json?                       @default("[]")
  created_by                String?                     @db.VarChar(50)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_service_device_models sps_service_device_models[]
}

model sps_devices {
  id                      Int                      @id @default(autoincrement())
  organization_id         String                   @db.Uuid
  service_id              String?                  @db.Uuid
  event_id                String?                  @db.Uuid
  device_code             String                   @unique @db.VarChar(50)
  api_key                 String?                  @unique @db.VarChar(100)
  name                    String?                  @db.VarChar(100)
  type                    String?                  @db.VarChar(50)
  status                  String?                  @default("OFFLINE") @db.VarChar(50)
  last_seen               DateTime?                @db.Timestamptz(6)
  metadata                Json?                    @default("{}")
  created_at              DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                @default(now()) @db.Timestamptz(6)
  sps_alerts              sps_alerts[]
  sps_events              sps_events?              @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  sps_organizations       sps_organizations        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_department_services sps_department_services? @relation(fields: [service_id], references: [id], onUpdate: NoAction)
  sps_telemetry           sps_telemetry[]

  @@index([device_code], map: "idx_devices_code")
  @@index([organization_id], map: "idx_devices_org")
  @@index([service_id], map: "idx_devices_service")
}

model sps_events {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id      String                 @db.Uuid
  name                 String                 @db.VarChar(100)
  code                 String?                @unique @db.VarChar(50)
  location             String?                @db.VarChar(255)
  start_date           DateTime?              @db.Timestamptz(6)
  end_date             DateTime?              @db.Timestamptz(6)
  status               String?                @default("PLANNING") @db.VarChar(50)
  description          String?
  event_type           String?                @db.VarChar(50)
  image_url            String?
  coordinates          Json?                  @default("{}")
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  sps_departments      sps_departments[]
  sps_devices          sps_devices[]
  sps_organizations    sps_organizations      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_role_assignments sps_role_assignments[]

  @@index([organization_id], map: "idx_events_org")
  @@index([status], map: "idx_events_status")
}

model sps_organizations {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                      String                      @unique @db.VarChar(100)
  slug                      String                      @unique @db.VarChar(50)
  code                      String?                     @unique @db.VarChar(50)
  type                      String?                     @default("CLIENT") @db.VarChar(50)
  description               String?
  industry                  String?                     @db.VarChar(100)
  website                   String?                     @db.VarChar(255)
  logo_url                  String?
  timezone                  String?                     @default("UTC") @db.VarChar(100)
  address                   String?
  city                      String?                     @db.VarChar(100)
  country                   String?                     @db.VarChar(100)
  phone                     String?                     @db.VarChar(50)
  vat_id                    String?                     @db.VarChar(50)
  billing_email             String?                     @db.VarChar(255)
  contact_email             String?                     @db.VarChar(255)
  plan_tier                 String?                     @default("BASIC") @db.VarChar(50)
  max_users                 Int?                        @default(5)
  max_devices               Int?                        @default(10)
  subscription_status       String?                     @default("ACTIVE") @db.VarChar(50)
  theme_config              Json?                       @default("{}")
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_alert_rules           sps_alert_rules[]
  sps_alerts                sps_alerts[]
  sps_audit_logs            sps_audit_logs[]
  sps_dashboard_templates   sps_dashboard_templates[]
  sps_department_templates  sps_department_templates[]
  sps_devices               sps_devices[]
  sps_events                sps_events[]
  sps_role_assignments      sps_role_assignments[]
  sps_service_subscriptions sps_service_subscriptions[]
  sps_tasks                 sps_tasks[]
  sps_users                 sps_users[]
}

model sps_permissions {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String                 @unique @db.VarChar(100)
  code                 String                 @unique @db.VarChar(50)
  description          String?
  category             String?                @db.VarChar(50)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  sps_role_permissions sps_role_permissions[]
}

model sps_role_assignments {
  id                      String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                 String                   @db.Uuid
  role                    String                   @db.VarChar(50)
  org_id                  String?                  @db.Uuid
  event_id                String?                  @db.Uuid
  dept_id                 String?                  @db.Uuid
  service_id              String?                  @db.Uuid
  created_at              DateTime?                @default(now()) @db.Timestamptz(6)
  sps_departments         sps_departments?         @relation(fields: [dept_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_events              sps_events?              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_organizations       sps_organizations?       @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_department_services sps_department_services? @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users               sps_users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_role_assign_user")
}

model sps_role_permissions {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role            String          @db.VarChar(50)
  permission_id   String          @db.Uuid
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  sps_permissions sps_permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role, permission_id])
}

model sps_service_device_models {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  service_template_id   String                @db.Uuid
  device_model_id       String                @db.VarChar(50)
  is_required           Boolean?              @default(false)
  max_devices           Int?
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  sps_device_models     sps_device_models     @relation(fields: [device_model_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates sps_service_templates @relation(fields: [service_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([service_template_id, device_model_id])
}

model sps_service_subscriptions {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id       String                @db.Uuid
  service_template_id   String                @db.Uuid
  status                String?               @default("ACTIVE") @db.VarChar(50)
  subscribed_at         DateTime?             @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?             @db.Timestamptz(6)
  config_overrides      Json?                 @default("{}")
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?             @default(now()) @db.Timestamptz(6)
  sps_organizations     sps_organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_service_templates sps_service_templates @relation(fields: [service_template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, service_template_id])
}

model sps_service_templates {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                      String                      @unique @db.VarChar(100)
  code                      String                      @unique @db.VarChar(50)
  category                  String?                     @default("MONITORING") @db.VarChar(50)
  description               String?
  config_schema             Json?                       @default("{}")
  default_config            Json?                       @default("{}")
  main_dashboard_layout     Json?                       @default("{\"widgets\": []}")
  public_dashboard_layout   Json?                       @default("{\"widgets\": []}")
  features                  Json?                       @default("[]")
  required_permissions      Json?                       @default("[]")
  base_price                Decimal?                    @default(0) @db.Decimal(10, 2)
  price_per_device          Decimal?                    @default(0) @db.Decimal(10, 2)
  is_public                 Boolean?                    @default(true)
  is_active                 Boolean?                    @default(true)
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  sps_department_services   sps_department_services[]
  sps_service_device_models sps_service_device_models[]
  sps_service_subscriptions sps_service_subscriptions[]
}

model sps_system_settings {
  id                            String    @id @default("sps_main_config") @db.VarChar(100)
  category                      String?   @default("global") @db.VarChar(50)
  site_title                    String?   @default("SustainPro") @db.VarChar(100)
  site_logo                     String?
  maintenance_mode              Boolean?  @default(false)
  default_timezone              String?   @default("Asia/Colombo") @db.VarChar(100)
  // Security Settings
  account_lock_duration_minutes Int?      @default(30)
  token_expire_minutes          Int?      @default(60)
  refresh_token_expire_days     Int?      @default(7)
  max_login_attempts            Int?      @default(5)
  session_timeout_enabled       Boolean?  @default(true)
  session_timeout_minutes       Int?      @default(30)
  // 2FA Policy Settings
  two_factor_required           Boolean?  @default(false)    // Force all users to enable 2FA
  two_factor_method             String?   @default("email") @db.VarChar(20)  // email, totp, or both
  otp_expiry_minutes            Int?      @default(10)
  otp_length                    Int?      @default(6)
  // Rate Limiting
  login_rate_limit_attempts     Int?      @default(5)
  login_rate_limit_window_mins  Int?      @default(15)
  // Support
  support_email                 String?   @db.VarChar(255)
  support_phone                 String?   @db.VarChar(50)
  global_alert_message          String?
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime? @default(now()) @db.Timestamptz(6)
}

model sps_task_evidence {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  task_id     String     @db.Uuid
  type        String     @db.VarChar(20)
  url         String
  description String?
  uploaded_by String?    @db.Uuid
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  sps_tasks   sps_tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sps_users   sps_users? @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model sps_tasks {
  id                                         String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id                            String              @db.Uuid
  department_id                              String?             @db.Uuid
  title                                      String              @db.VarChar(200)
  description                                String?
  priority                                   String?             @default("MEDIUM") @db.VarChar(20)
  status                                     String?             @default("PENDING") @db.VarChar(20)
  assigned_to                                String?             @db.Uuid
  created_by                                 String?             @db.Uuid
  due_date                                   DateTime?           @db.Timestamptz(6)
  completed_at                               DateTime?           @db.Timestamptz(6)
  created_at                                 DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime?           @default(now()) @db.Timestamptz(6)
  sps_task_evidence                          sps_task_evidence[]
  sps_users_sps_tasks_assigned_toTosps_users sps_users?          @relation("sps_tasks_assigned_toTosps_users", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_users_sps_tasks_created_byTosps_users  sps_users?          @relation("sps_tasks_created_byTosps_users", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sps_departments                            sps_departments?    @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  sps_organizations                          sps_organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organization_id], map: "idx_tasks_org")
}

model sps_telemetry {
  id              Int          @id @default(autoincrement())
  device_id       Int?
  device_code     String       @db.VarChar(50)
  organization_id String       @db.Uuid
  event_id        String?      @db.Uuid
  service_id      String?      @db.Uuid
  data            Json
  recorded_at     DateTime?    @default(now()) @db.Timestamptz(6)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  sps_devices     sps_devices? @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([device_id], map: "idx_telemetry_device")
  @@index([organization_id], map: "idx_telemetry_org")
  @@index([recorded_at(sort: Desc)], map: "idx_telemetry_recorded")
}

model sps_users {
  id                                         String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id                            String?                   @db.Uuid
  code                                       String?                   @unique @db.VarChar(50)
  email                                      String                    @unique @db.VarChar(255)
  password_hash                              String
  full_name                                  String?                   @db.VarChar(100)
  timezone                                   String?                   @default("UTC") @db.VarChar(50)
  is_active                                  Boolean?                  @default(true)
  is_super_admin                             Boolean?                  @default(false)
  failed_login_attempts                      Int?                      @default(0)
  account_locked_until                       DateTime?                 @db.Timestamptz(6)
  last_login                                 DateTime?                 @db.Timestamptz(6)
  // 2FA Fields
  two_factor_enabled                         Boolean?                  @default(false)
  two_factor_secret                          String?                   @db.VarChar(255)  // Encrypted TOTP secret
  two_factor_backup_codes                    String?                   @db.Text          // Encrypted backup codes (JSON array)
  two_factor_verified_at                     DateTime?                 @db.Timestamptz(6)
  // Email verification
  email_verified                             Boolean?                  @default(false)
  email_verified_at                          DateTime?                 @db.Timestamptz(6)
  // Session management
  force_password_change                      Boolean?                  @default(false)
  password_changed_at                        DateTime?                 @db.Timestamptz(6)
  created_at                                 DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime?                 @default(now()) @db.Timestamptz(6)
  sps_alerts                                 sps_alerts[]
  sps_audit_logs                             sps_audit_logs[]
  sps_dashboard_templates                    sps_dashboard_templates[]
  sps_department_services                    sps_department_services[]
  sps_departments                            sps_departments[]
  sps_role_assignments                       sps_role_assignments[]
  sps_task_evidence                          sps_task_evidence[]
  sps_tasks_sps_tasks_assigned_toTosps_users sps_tasks[]               @relation("sps_tasks_assigned_toTosps_users")
  sps_tasks_sps_tasks_created_byTosps_users  sps_tasks[]               @relation("sps_tasks_created_byTosps_users")
  sps_organizations                          sps_organizations?        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@index([organization_id], map: "idx_users_org")
  sps_refresh_tokens                         sps_refresh_tokens[]
  sps_otp_codes                              sps_otp_codes[]
  sps_user_sessions                          sps_user_sessions[]
}

// Refresh Tokens - for secure token storage and revocation
model sps_refresh_tokens {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String    @db.Uuid
  token_hash     String    @db.VarChar(255)  // Hashed refresh token for security
  device_info    String?   @db.VarChar(500)  // Browser/device identifier
  ip_address     String?   @db.VarChar(45)   // IPv4 or IPv6
  expires_at     DateTime  @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_reason String?   @db.VarChar(100)  // logout, password_change, admin_action, etc.
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  
  sps_users      sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([token_hash], map: "idx_refresh_tokens_hash")
  @@index([expires_at], map: "idx_refresh_tokens_expires")
}

// OTP Codes - for email verification and password reset
model sps_otp_codes {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  code_hash    String    @db.VarChar(255)  // Hashed OTP code
  purpose      String    @db.VarChar(50)   // email_verification, password_reset, login_2fa
  expires_at   DateTime  @db.Timestamptz(6)
  used_at      DateTime? @db.Timestamptz(6)
  attempts     Int       @default(0)       // Track verification attempts
  max_attempts Int       @default(3)       // Prevent brute force
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  
  sps_users    sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@index([user_id], map: "idx_otp_codes_user")
  @@index([expires_at], map: "idx_otp_codes_expires")
}

// User Sessions - for session management and timeout handling
model sps_user_sessions {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String    @db.Uuid
  refresh_token_id String?  @db.Uuid
  device_info     String?   @db.VarChar(500)
  ip_address      String?   @db.VarChar(45)
  user_agent      String?   @db.VarChar(500)
  last_activity   DateTime  @default(now()) @db.Timestamptz(6)
  expires_at      DateTime  @db.Timestamptz(6)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  
  sps_users       sps_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@index([user_id], map: "idx_user_sessions_user")
  @@index([last_activity], map: "idx_user_sessions_activity")
  @@index([is_active], map: "idx_user_sessions_active")
}
