# ==============================================
# SustainPro Notification Service Configuration
# ==============================================

# Server
PORT=5003
NODE_ENV=development

# Database (for notification logs - optional)
DATABASE_URL=postgresql://sustainpro:sustainpro_dev@localhost:5434/sustainpro

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# ==============================================
# RabbitMQ - Message Broker
# ==============================================
RABBITMQ_URL=amqp://sustainpro:sustainpro_dev@localhost:5700
RABBITMQ_ENABLED=true

# ==============================================
# SMTP Configuration
# ==============================================
# 
# For TESTING (recommended for development):
# -----------------------------------------
# Option 1: Ethereal Email (Free, auto-created accounts)
#   - Leave SMTP_USER and SMTP_PASSWORD empty
#   - Service will auto-create a test account
#   - Emails are captured, not sent
#   - View emails at: https://ethereal.email
#
# Option 2: Mailtrap (Free tier available)
#   - Sign up at: https://mailtrap.io
#   - Create an inbox
#   - Use provided SMTP credentials
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=your_mailtrap_user
#   SMTP_PASSWORD=your_mailtrap_password
#
# For PRODUCTION:
# ---------------
# Option 1: SendGrid
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your_sendgrid_api_key
#
# Option 2: AWS SES
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=your_ses_smtp_user
#   SMTP_PASSWORD=your_ses_smtp_password
#
# Option 3: Mailgun
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USER=postmaster@your-domain.mailgun.org
#   SMTP_PASSWORD=your_mailgun_password
#
# ==============================================

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Email From Address
EMAIL_FROM_NAME=SustainPro
EMAIL_FROM_ADDRESS=noreply@sustainpro.io

# ==============================================
# Template Configuration
# ==============================================
OTP_EXPIRY_MINUTES=10
COMPANY_NAME=SustainPro
SUPPORT_EMAIL=support@sustainpro.io
LOGO_URL=https://sustainpro.io/logo.png

# ==============================================
# Rate Limiting
# ==============================================
MAX_EMAILS_PER_MINUTE=60
MAX_SMS_PER_MINUTE=30

# ==============================================
# Retry Configuration
# ==============================================
NOTIFICATION_RETRY_MAX=3
NOTIFICATION_RETRY_DELAY_MS=1000
NOTIFICATION_RETRY_BACKOFF=2
