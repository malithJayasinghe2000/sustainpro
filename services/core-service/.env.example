# Core Service Environment Variables
PORT=5001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://sustainpro:sustainpro_dev@localhost:5432/sustainpro

# JWT (for token verification)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# RabbitMQ
RABBITMQ_URL=amqp://sustainpro:sustainpro_dev@localhost:5672
RABBITMQ_ENABLED=true

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=sustainpro-uploads

# AWS IoT Core (for device provisioning)
AWS_IOT_ENABLED=false
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_POLICY_NAME=SustainProDevicePolicy

# Upload Limits
MAX_FILE_SIZE=5242880
