# IoT Service Environment Variables
PORT=5002
NODE_ENV=development

# Database
DATABASE_URL=postgresql://sustainpro:sustainpro_dev@localhost:5432/sustainpro

# JWT (for token verification - must match auth-service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# RabbitMQ
RABBITMQ_URL=amqp://sustainpro:sustainpro_dev@localhost:5672
RABBITMQ_ENABLED=true

# AWS IoT Webhook
AWS_IOT_WEBHOOK_SECRET=your-aws-iot-webhook-secret

# Live Data Settings
OFFLINE_THRESHOLD_MS=10000
CLEANUP_INTERVAL_MS=60000
