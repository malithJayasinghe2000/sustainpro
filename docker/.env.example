# SustainPro Production Environment Variables
# Copy this file to .env and fill in the values

# ========================================
# Database
# ========================================
POSTGRES_USER=sustainpro
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=sustainpro

# ========================================
# RabbitMQ
# ========================================
RABBITMQ_USER=sustainpro
RABBITMQ_PASSWORD=your-secure-password-here

# ========================================
# Authentication
# ========================================
JWT_SECRET=your-very-long-and-secure-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# ========================================
# CORS
# ========================================
CORS_ORIGINS=https://app.sustainpro.io,https://dashboard.sustainpro.io

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_IOT_ENABLED=true
AWS_IOT_POLICY_NAME=SustainProDevicePolicy
AWS_S3_BUCKET=sustainpro-uploads

# ========================================
# Webhooks
# ========================================
WEBHOOK_SECRET=your-webhook-secret-for-aws-iot
