{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "product_name": "RabbitMQ",
  "product_version": "3.12.0",
  "users": [
    {
      "name": "sustainpro",
      "password_hash": "lV7D2h+w3pZeKfB7nQaJLxYqAQVg5kZ5qZQo6f4XN5jFFQ7h",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "sustainpro",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "sustainpro-rabbitmq"
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    }
  ],
  "queues": [
    {
      "name": "device.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 86400000,
        "x-dead-letter-exchange": "sustainpro.dlx",
        "x-dead-letter-routing-key": "device.events.dead"
      }
    },
    {
      "name": "telemetry.raw",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 3600000,
        "x-dead-letter-exchange": "sustainpro.dlx",
        "x-dead-letter-routing-key": "telemetry.raw.dead"
      }
    },
    {
      "name": "telemetry.processed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "alerts",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 604800000,
        "x-max-priority": 10
      }
    },
    {
      "name": "notifications",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "device.events.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "telemetry.raw.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "sustainpro.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "sustainpro.telemetry",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "sustainpro.alerts",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "sustainpro.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "sustainpro.events",
      "vhost": "/",
      "destination": "device.events",
      "destination_type": "queue",
      "routing_key": "device.#",
      "arguments": {}
    },
    {
      "source": "sustainpro.telemetry",
      "vhost": "/",
      "destination": "telemetry.raw",
      "destination_type": "queue",
      "routing_key": "raw",
      "arguments": {}
    },
    {
      "source": "sustainpro.telemetry",
      "vhost": "/",
      "destination": "telemetry.processed",
      "destination_type": "queue",
      "routing_key": "processed",
      "arguments": {}
    },
    {
      "source": "sustainpro.alerts",
      "vhost": "/",
      "destination": "alerts",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "sustainpro.alerts",
      "vhost": "/",
      "destination": "notifications",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "sustainpro.dlx",
      "vhost": "/",
      "destination": "device.events.dead",
      "destination_type": "queue",
      "routing_key": "device.events.dead",
      "arguments": {}
    },
    {
      "source": "sustainpro.dlx",
      "vhost": "/",
      "destination": "telemetry.raw.dead",
      "destination_type": "queue",
      "routing_key": "telemetry.raw.dead",
      "arguments": {}
    }
  ]
}
