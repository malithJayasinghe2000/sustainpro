# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/sustainpro?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# CORS Configuration - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://yourdomain.com"

# AWS IoT Core Configuration
AWS_IOT_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_IOT_ENDPOINT=xxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_POLICY_NAME=SustainProDevicePolicy

# AWS IoT Core Webhook Secret (for validating requests from AWS IoT Rules)
AWS_IOT_WEBHOOK_SECRET=your_random_webhook_secret_change_this
