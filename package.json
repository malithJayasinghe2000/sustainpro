{
    "name": "sustainpro",
    "version": "1.0.0",
    "private": true,
    "description": "SustainPro IoT Event Management Platform - Microservices Architecture",
    "workspaces": [
        "packages/*",
        "services/*",
        "frontend"
    ],
    "scripts": {
        "setup": "node scripts/setup.js",
        "setup:local": "bash scripts/setup-local.sh",
        "setup:local:win": "scripts\\setup-local.bat",
        "setup:docker": "cd docker && docker-compose up -d && cd .. && npm run prisma:generate && npm run db:push && npm run db:seed",
        "deploy:prod": "bash scripts/deploy-production.sh",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "clean": "turbo run clean",
        "dev:backend": "turbo run dev --filter=@sustainpro/*-service",
        "dev:frontend": "turbo run dev --filter=frontend",
        "build:packages": "turbo run build --filter=@sustainpro/shared-*",
        "prisma:generate": "npm run prisma:generate --workspace=@sustainpro/shared-database",
        "prisma:studio": "npm run prisma:studio --workspace=@sustainpro/shared-database",
        "db:push": "npm run prisma:push --workspace=@sustainpro/shared-database",
        "db:seed": "npm run prisma:seed --workspace=@sustainpro/shared-database"
    },
    "devDependencies": {
        "@types/express-serve-static-core": "^5.0.7",
        "turbo": "^2.3.0",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "npm@11.0.0",
    "dependencies": {
        "argon2": "^0.44.0",
        "pg": "^8.16.3"
    }
}
